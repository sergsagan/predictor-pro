{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "@features/*": [
        "./app/features/*"
      ],
      "@shared/*": [
        "./app/shared/*"
      ],
      "@server/*": [
        "./server/*"
      ],
      "@db/*": [
        "./db/*"
      ]
    }
  }
}
