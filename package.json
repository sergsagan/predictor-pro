    "@vueuse/nuxt": "^14.3.0",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.8.0",
    "nuxt": "^4.5.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@nuxt/test-utils": "^4.0.3",
    "@pinia/testing": "^2.0.1",
    "@types/node": "^26.4.0",
    "@vue/test-utils": "^2.4.11",
