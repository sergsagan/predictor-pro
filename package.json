    "@vueuse/nuxt": "^14.4.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.8.1",
    "nuxt": "^4.6.4",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nuxt/test-utils": "^4.4.0",
    "@pinia/testing": "^2.0.2",
    "@types/node": "^26.6.6",
